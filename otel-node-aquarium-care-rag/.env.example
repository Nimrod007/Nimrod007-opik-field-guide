OPENAI_API_KEY=your-openai-api-key

# Opik over OTLP (local defaults; telemetry.ts reads these)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=otel-node-aquarium-care-rag
# Opt in to prompt/completion text on spans (GenAI semantic-convention switch; off by default)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
