# OpenAI: the assistant runs on gpt-4o-mini
OPENAI_API_KEY=sk-...

# Opik OTLP endpoint. Defaults to a local self-hosted Opik.
# Opik Cloud: https://www.comet.com/opik/api/v1/private/otel
# OPIK_OTEL_ENDPOINT=http://localhost:5173/api/v1/private/otel

# Workspace and project the traces land in
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=voltagent-bike-repair-desk

# Only needed for Opik Cloud (never commit a real key)
# OPIK_API_KEY=

# Set to true to switch trace export off (the unit tests do this)
# OTEL_SDK_DISABLED=true
