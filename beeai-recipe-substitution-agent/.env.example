# OpenAI: the agent runs on gpt-4o-mini
OPENAI_API_KEY=sk-...

# Opik: workspace and API base. Defaults point at Opik Cloud; for a local self-hosted Opik use:
OPIK_WORKSPACE=default
# OPIK_URL_OVERRIDE=http://localhost:5173/api
# Opik Cloud only (leave unset for a local Opik):
# OPIK_API_KEY=

# Set to true to run without any tracing
# OTEL_SDK_DISABLED=true
