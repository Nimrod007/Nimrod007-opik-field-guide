# Copy to .env at the repo root and fill in. Every example walks up to find this file.
# .env is git-ignored; never commit real keys.

# --- Opik (local self-hosted: https://www.comet.com/docs/opik/self-host/local_deployment) ---
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY is not needed for a local Opik. For Opik Cloud, set it plus OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/

# --- LLM providers ---
# Required by almost every example: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional, for the Anthropic and multi-provider examples: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
