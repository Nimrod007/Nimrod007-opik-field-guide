# Copy to .env at the repo root and fill in. Every example walks up to find this file.
# .env is git-ignored; never commit real keys.

# --- Opik ---
# Local self-hosted Opik (https://www.comet.com/docs/opik/self-host/local_deployment) needs no key.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud instead: set OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/ and your key.
# Get one at https://www.comet.com/docs/opik/tracing/sdk_configuration
OPIK_API_KEY=
# Optional: each example already sets its own project; override here to redirect traces.
# OPIK_PROJECT_NAME=
# Optional: turn tracing off (offline tests use this). Python and TS SDKs honour it.
# OPIK_TRACK_DISABLE=true

# --- OpenTelemetry-based examples (Mastra, VoltAgent, BeeAI, smolagents, Pydantic AI, Node OTel) ---
# OTLP endpoint for a local Opik; send header Comet-Workspace=default (no Authorization needed locally).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
# OTEL_SDK_DISABLED=true                                 # turn OTel export off (offline tests)
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true # put prompt/completion text on spans

# --- LLM providers ---
# Required by almost every example: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Used by the Anthropic and multi-provider examples: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Local services used by single examples ---
# TEMPORAL_ADDRESS=localhost:7233   # temporal-py-grant-review (temporal server start-dev)
# OLLAMA_URL=http://localhost:11434 # ollama-ham-radio-rag
