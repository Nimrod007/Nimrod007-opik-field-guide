# OpenAI: image generation (gpt-image-1, lowest quality, smallest size)
OPENAI_API_KEY=sk-...

# Opik: local self-hosted shown; for Opik Cloud use https://www.comet.com/opik/api plus a key
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=
# Set to true to switch tracing off (unit tests do this)
# OPIK_TRACK_DISABLE=true
