# Model provider key (the repo-root .env also works).
OPENAI_API_KEY=

# Opik (local self-hosted; no API key needed). For Opik Cloud also set OPIK_API_KEY and
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api and OPIK_WORKSPACE=<your workspace>.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_PROJECT_NAME=mastra-utility-account-agent
