# Used for embeddings (text-embedding-3-small), answers (gpt-4o-mini) and the suite's LLM judge.
# You can also keep the key in a parent directory's .env - it is picked up too.
OPENAI_API_KEY=your-openai-key

# Opik: nothing needed for a local install configured with `opik configure`.
# For Opik Cloud also set:
# OPIK_API_KEY=your-opik-key
# OPIK_WORKSPACE=your-workspace
