{
  "name": "vercel-ai-sveltekit-stargazing-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Streaming stargazing chat in SvelteKit on the Vercel AI SDK, traced with opik-vercel",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "demo": "node scripts/demo.mjs",
    "test": "vitest run",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.92",
    "@ai-sdk/otel": "1.0.138",
    "@ai-sdk/svelte": "5.0.138",
    "@opentelemetry/sdk-node": "^0.222.0",
    "ai": "7.0.138",
    "dotenv": "^17.2.0",
    "opik": "2.2.99",
    "opik-vercel": "2.2.99",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^22.0.0",
    "chokidar": "^4.0.3",
    "readdirp": "^4.1.2",
    "svelte": "5.57.2",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.4",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "opik-vercel": {
      "opik": "$opik"
    }
  }
}
