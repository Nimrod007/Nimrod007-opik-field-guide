# Keys are read from this folder's .env or from a .env further up the tree.
OPENAI_API_KEY=your-openai-key

# Local self-hosted Opik. For Opik Cloud also set OPIK_API_KEY and use https://www.comet.com/opik/api
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default

# Optional: port the demo boots the server on
# DEMO_PORT=4191
