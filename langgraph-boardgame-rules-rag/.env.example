# Provider key for embeddings, generation and the LLM judges.
# (Copy to .env, or keep the key in a parent directory's .env - it is picked up too.)
OPENAI_API_KEY=your-openai-key

# Opik: nothing needed for a local `opik` install configured via `opik configure`.
# For Opik Cloud also set:
# OPIK_API_KEY=your-opik-key
# OPIK_WORKSPACE=your-workspace
